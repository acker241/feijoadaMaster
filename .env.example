# Variaveis do servico no Railway (Settings > Variables).
# Nenhuma delas entra no repositorio.

# Postgres do proprio Railway: use a referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Turnstile (dash.cloudflare.com > Turnstile). A sitekey e publica, a secret nao.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Painel /admin
# gere o hash com:  node server/hash-senha.js "sua senha longa"
ADMIN_SENHA_HASH=
# segredo para assinar o cookie de sessao:  openssl rand -hex 32
SESSAO_SEGREDO=

# Aviso de mensagem nova no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL publica do site, usada nos avisos e para marcar o cookie como Secure
SITE_URL=https://www.feijoadadomaster.com.br
